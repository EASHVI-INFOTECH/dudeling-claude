{
  "name": "dudeling-claude",
  "version": "1.0.0-rc.6",
  "description": "Dudeling for Claude Desktop: a tutor that teaches on a whiteboard inside your chat, with a voice and ears that run on your Mac. No API keys, no accounts.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "dudeling-claude": "server/stdio.ts"
  },
  "scripts": {
    "build": "vite build",
    "dev:view": "vite --host 127.0.0.1",
    "stdio": "node server/stdio.ts",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "voice": "node scripts/fetch-models.ts",
    "pack": "node scripts/pack.mjs",
    "test:packed": "DUDELING_PACKED=dudeling-darwin-arm64.mcpb node --test test/packed.test.ts",
    "release:check": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "kokoro-js": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.50.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "overrides": {
    "sharp": "0.35.5",
    "onnxruntime-node": "1.31.1",
    "onnxruntime-common": "1.31.1"
  }
}
